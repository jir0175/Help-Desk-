<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Подключаем наш SQL-файл со всеми таблицами -->
    <include file="db/changelog/changesets/01-init-schema.sql"/>
    <changeSet id="add-user-id-to-tickets" author="dev">
        <addColumn tableName="tickets">
            <column name="user_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_tickets_user"
                             referencedTableName="users"
                             referencedColumnNames="id"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>